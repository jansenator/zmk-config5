#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        jlrHRM: jlrHRM {
            compatible = "zmk,behavior-hold-tap";
            label = "JLRHRM";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            hold-trigger-key-positions = <32 31 30 29 41 42 43 44>;
            hold-trigger-on-release;
        };
    };

    macros {
        /* Ctrl, Ctrl, 0 (tap sequence) */

        KVMswitch: KVMswitch {
            compatible = "zmk,behavior-macro";
            label = "KVMSWITCH";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp N0>;
        };

        /* macOS Tile Left Half: Globe + Ctrl + Left */

        TileLeftHalf: TileLeftHalf {
            compatible = "zmk,behavior-macro";
            label = "TILELEFTHALF";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE &kp LCTRL>,
                <&macro_tap>,
                <&kp LEFT>,
                <&macro_release>,
                <&kp LCTRL &kp GLOBE>;
        };

        /* macOS Tile Right Half: Globe + Ctrl + Right */

        TileRightHalf: TileRightHalf {
            compatible = "zmk,behavior-macro";
            label = "TILERIGHTHALF";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE &kp LCTRL>,
                <&macro_tap>,
                <&kp RIGHT>,
                <&macro_release>,
                <&kp LCTRL &kp GLOBE>;
        };

        /* macOS Tile Bottom Half: Globe + Ctrl + Down */

        TileBottomHalf: TileBottomHalf {
            compatible = "zmk,behavior-macro";
            label = "TILEBOTTOMHALF";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp GLOBE &kp LCTRL>,
                <&macro_tap>,
                <&kp DOWN>,
                <&macro_release>,
                <&kp LCTRL &kp GLOBE>;
        };

        /* macOS Tile Top Half: Globe + Ctrl + Up */

        TileTopHalf: TileTopHalf {
            compatible = "zmk,behavior-macro";
            label = "TILETOPHALF";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LC(GLOBE)>,
                <&macro_tap>,
                <&kp UP_ARROW>,
                <&macro_release>,
                <&kp LC(GLOBE)>;
        };

        /* Your test macro corrected to proper macro step format */
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp EQUAL       &kp N1             &kp N2     &kp N3      &kp N4      &kp N5  &kp LC(LA(ENTER))                                                                                                     &mo 3  &kp N6  &kp N7                &kp N8            &kp N9             &kp N0    &kp MINUS
&kp TAB         &kp Q              &kp W      &kp E       &kp R       &kp T   &kp LA(SPACE)                                                                                                         &mo 2  &kp Y   &kp U                 &kp I             &kp O              &kp P     &kp BACKSLASH
&kp BACKSPACE   &kp A              &kp S      &kp D       &kp F       &kp G   &kp RA(RS(RC(RG(D))))                       &mo 1       &KVMswitch       &kp LS(LC(C))  &kp LC(LA(LG(Q)))             &none  &kp H   &kp J                 &kp K             &kp L              &kp SEMI  &kp APOSTROPHE
&kp LEFT_SHIFT  &kp Z              &kp X      &kp C       &kp V       &kp B                                                           &kp LG(LS(H))    &kp PAGE_UP                                         &kp N   &kp M                 &kp COMMA         &kp DOT            &kp FSLH  &kp RIGHT_SHIFT
&kp RIGHT_ALT   &kp RIGHT_CONTROL  &kp GRAVE  &caps_word  &kp DELETE                                 &mt RIGHT_GUI ENTER  &kp ESCAPE  &kp LG(LS(M))    &kp PAGE_DOWN  &none              &kp SPACE                 &kp LEFT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &mo 1     &kp RCTRL
            >;
        };

        layer_1 {
            bindings = <
&trans    &kp END        &kp LC(DOWN)          &kp LC(UP)              &kp LA(LC(LG(N)))      &kp C_PLAY_PAUSE   &trans                                                    &trans  &trans  &trans    &trans    &trans     &trans  &trans
&trans    &kp HOME       &kp LG(LS(GRAVE))     &kp LC(LG(UP_ARROW))    &kp LG(GRAVE)          &kp C_VOL_UP       &trans                                                    &trans  &trans  &trans    &kp UP    &trans     &trans  &trans
&kp CAPS  &kp LG(PLUS)   &kp LC(LG(LEFT))      &kp LC(LG(DOWN_ARROW))  &kp LC(LG(RIGHT))      &kp C_VOL_DN       &trans          &trans  &trans    &trans  &trans          &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
&trans    &kp LG(MINUS)  &kp LG(LA(LEFT))      &msc SCRL_DOWN          &kp LG(LA(RIGHT))      &kp LG(LC(SPACE))                          &trans    &trans                          &trans  &trans    &trans    &trans     &trans  &trans
&trans    &kp LS(LC(C))  &kp LG(LEFT_BRACKET)  &msc SCRL_UP            &kp LG(RIGHT_BRACKET)                             &trans  &trans  &trans    &trans  &trans  &trans                  &trans    &trans    &trans     &trans  &trans
            >;
        };

        fn {
            bindings = <
&none   &kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &none                                                    &none  &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &none
&trans  &kp F11  &kp F12  &kp F13  &kp F14  &kp F15  &none                                                    &none  &kp F16  &kp F17  &kp F18  &kp F19  &kp F20  &trans
&trans  &trans   &trans   &trans   &trans   &trans   &none          &trans  &trans    &trans  &trans          &none  &trans   &trans   &trans   &trans   &trans   &trans
&trans  &trans   &trans   &trans   &trans   &trans                          &trans    &trans                         &trans   &trans   &trans   &trans   &trans   &trans
&trans  &trans   &trans   &trans   &trans                   &trans  &trans  &trans    &trans  &trans  &trans                  &trans   &trans   &trans   &trans   &trans
            >;
        };

        mod {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                                        &trans       &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none         &bootloader                                                                  &bootloader  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none         &none               &none  &none    &bt BT_CLR  &none                        &none        &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none                                    &none    &none                                                 &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none                                    &none  &none  &none    &none       &bl BL_TOG  &rgb_ug RGB_TOG                      &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
